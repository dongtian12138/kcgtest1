    def "PhysicsMaterials"
    {
        def Material "robot_structure" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            custom string kcg:materialRole = "robot_structure"
            custom string kcg:responseRole = "hard_rigid"
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.35
            bool physxMaterial:compliantContactAccelerationSpring = 0
            float physxMaterial:compliantContactDamping = 0
            float physxMaterial:compliantContactStiffness = 0
            token physxMaterial:dampingCombineMode = "max"
            token physxMaterial:frictionCombineMode = "max"
            token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "finger_structure" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            custom string kcg:materialRole = "finger_structure"
            custom string kcg:responseRole = "hard_rigid"
            float physics:dynamicFriction = 0.25
            float physics:restitution = 0
            float physics:staticFriction = 0.35
            bool physxMaterial:compliantContactAccelerationSpring = 0
            float physxMaterial:compliantContactDamping = 0
            float physxMaterial:compliantContactStiffness = 0
            token physxMaterial:dampingCombineMode = "max"
            token physxMaterial:frictionCombineMode = "max"
            token physxMaterial:restitutionCombineMode = "min"
        }

        def Material "fingertip_pad" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            custom string kcg:materialRole = "fingertip_pad"
            custom string kcg:responseRole = "hard_rigid"
            float physics:dynamicFriction = 1.4
            float physics:restitution = 0
            float physics:staticFriction = 1.4
            bool physxMaterial:compliantContactAccelerationSpring = 0
            float physxMaterial:compliantContactDamping = 0
            float physxMaterial:compliantContactStiffness = 0
            token physxMaterial:dampingCombineMode = "max"
            token physxMaterial:frictionCombineMode = "max"
            token physxMaterial:restitutionCombineMode = "min"
        }
    }

    over "Physics"
    {
        over "f1j3" (
            apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "NewtonMimicAPI", "PhysicsJointStateAPI:angular", "IsaacJointAPI"]
        )
        {
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
            bool newton:mimicEnabled = 1
            rel newton:mimicJoint = </handarm/Physics/f1j2>
            custom float newton:mimicMultiplier = 1
            custom float newton:mimicOffset = 0
        }

        over "f2j2" (
            apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI", "NewtonMimicAPI", "PhysicsJointStateAPI:angular", "IsaacJointAPI"]
