#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "handarm"
    doc = """Generated from Composed Stage of root layer /tmp/tmpd9kq3pwq/handarm.usdc


