  <!--
    Task frame at the geometric center of the open three-finger workspace.
    It is collision-free and is used for grasp planning, task observations,
    and later RL rewards.  The offset was measured from the actual hand meshes.
  -->
  <link name="grasp_tcp"/>
  <joint name="handbase_to_grasp_tcp" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.400"/>
    <parent link="handbase_link"/>
    <child link="grasp_tcp"/>
  </joint>

  <!--
    The physical hand has three Wheatstone-full-bridge strain channels, not
    fingertip tactile sensors.  Gazebo's joint force/torque sensor is used only
    as the physics source; ros2_control exports the torque about the local
    joint z axis and discards the other five wrench components.
  -->
  <gazebo reference="f1j2">
    <sensor name="f1j2" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <force_torque>
        <frame>child</frame>
        <measure_direction>child_to_parent</measure_direction>
      </force_torque>
    </sensor>
  </gazebo>

  <gazebo reference="f2j1">
    <sensor name="f2j1" type="force_torque">
